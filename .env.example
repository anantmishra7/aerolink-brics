# AEROLINK BRICS — Environment Variables Configuration
# Copy this file to .env and configure your API keys for live feeds.
# If keys are left blank, AEROLINK BRICS automatically falls back to verified simulation data.

# 1. AI & Computer Vision Service (Google Gemini or OpenAI)
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_AI_VISION_MODEL=gemini-1.5-flash

# 2. Real-Time Air Quality Ground Monitoring (OpenAQ / WAQI)
VITE_OPENAQ_API_KEY=
VITE_WAQI_API_KEY=

# 3. Meteorological & Wind Feeds (OpenWeatherMap / WeatherAPI)
VITE_OPENWEATHER_API_KEY=

# 4. Satellite Observations & Remote Sensing (Copernicus Sentinel-5P Hub / NASA FIRMS)
VITE_SENTINEL_HUB_CLIENT_ID=
VITE_SENTINEL_HUB_CLIENT_SECRET=
VITE_NASA_FIRMS_MAP_KEY=

# 5. Application Mode ('production' | 'demo' | 'simulation')
VITE_APP_MODE=demo
VITE_ENABLE_FEDERATED_SIMULATION=true
